# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dataset cache (staged on cloud per CLOUD_TRAINING.md)
data/metadit/*
!data/metadit/.gitkeep

# Checkpoint artifacts — keep only REPORT.md/BUGLOG.md records
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/*/
!checkpoints/*/REPORT.md
!checkpoints/*/BUGLOG.md
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
checkpoints/**/*.json
checkpoints/**/*.jsonl
!checkpoints/**/REPORT.md
!checkpoints/**/BUGLOG.md
checkpoints/**/adaptive/

# Logs
logs/*
!logs/.gitkeep

# Root-level probe/debug scratch files (out_*.py/.json/.txt)
/out_*
/_audit_*
/_fetch_log*
/_probe_*
/_regen_b64.py
/_splice_kernel.py
/_s4*
/_local_diff.b64
/poll_v4.py
/k8_*

# Kaggle session scratch (pulled outputs, sharded checkpoints, metrics)
.kaggle_*/
kaggle_anosvol_dataset/
.metadit_stage_*/
.tmp_stage4_pull/
temp_test_data/
p2/

# Model weights anywhere
*.safetensors
*.ckpt
*.pt
*.pth

# Misc
*.log
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
.ipynb_checkpoints/